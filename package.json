{
  "name": "la-fabrique",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The control panel for a software project built with Claude.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrations:local": "wrangler d1 migrations apply la-fabrique-db --local",
    "migrations:remote": "wrangler d1 migrations apply la-fabrique-db --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.6.3",
    "vitest": "~2.1.9",
    "wrangler": "^3.95.0"
  },
  "engines": {
    "node": ">=20"
  }
}
