{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-fabrique",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.css", "**/site/*.js", "**/docs/*.md", "**/docs/exemples/*.yml", "**/kit/*.js", "**/kit/*.css"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "la-fabrique-db",
      "database_id": "b39b55e1-f116-4efd-8834-efddb7b00a69",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "COMMIT_SHA": "dev"
  },
  "observability": {
    "enabled": true
  }
}
