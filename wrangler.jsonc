{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-fabrique",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html", "**/*.css"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "la-fabrique-db",
      // Replace with the real D1 id after `wrangler d1 create la-fabrique-db`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "COMMIT_SHA": "dev"
  },
  "observability": {
    "enabled": true
  }
}
