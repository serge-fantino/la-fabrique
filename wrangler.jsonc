{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-fabrique",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.css", "**/site/*.js", "**/docs/*.md", "**/docs/exemples/*.yml", "**/kit/*.js", "**/kit/*.css"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "la-fabrique-db",
      "database_id": "b39b55e1-f116-4efd-8834-efddb7b00a69",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "COMMIT_SHA": "dev",
    // Claude in La Fabrique: ANTHROPIC_API_KEY is a secret (wrangler secret put).
    "CLAUDE_MODEL": "claude-opus-5-5",
    "CLAUDE_DAILY_CALLS": "30",
    "CLAUDE_MONTHLY_BUDGET_USD": "20"
  },
  // Claude works in the background (docs/decisions/0001-claude-in-the-background.md):
  // a queue of its jobs (created by the deploy workflow if missing), and an
  // object per card that pushes their progress to the open pages.
  "queues": {
    "producers": [{ "binding": "CLAUDE_QUEUE", "queue": "la-fabrique-claude" }],
    "consumers": [
      { "queue": "la-fabrique-claude", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3, "max_concurrency": 2, "retry_delay": 30 }
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "CARD_LIVE", "class_name": "CardLive" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CardLive"] }],
  "observability": {
    "enabled": true
  }
}
